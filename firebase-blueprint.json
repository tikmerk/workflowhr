{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Employee record including profile, department, designation, and biometric data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeCode": { "type": "string" },
        "fullName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string" },
        "designationTitle": { "type": "string" },
        "departmentName": { "type": "string" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "faceRegisteredPhoto": { "type": "string" },
        "faceTemplateRegistered": { "type": "boolean" },
        "faceRegisteredAt": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "employeeCode", "fullName", "role"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Branch location and geofence configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "totalEmployees": { "type": "number" }
      },
      "required": ["id", "name", "code"]
    },
    "Department": {
      "title": "Department",
      "description": "Organizational department structure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "totalEmployees": { "type": "number" }
      },
      "required": ["id", "name", "code"]
    },
    "Designation": {
      "title": "Designation",
      "description": "Job titles and salary grading",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "code": { "type": "string" },
        "departmentId": { "type": "string" }
      },
      "required": ["id", "title", "code"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Clock in / Clock out biometric attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "checkInTime": { "type": "string" },
        "status": { "type": "string" },
        "branchName": { "type": "string" }
      },
      "required": ["id", "employeeId", "date"]
    },
    "LeaveApplication": {
      "title": "LeaveApplication",
      "description": "Employee leave request record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "leaveType": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["id", "employeeId", "leaveType", "status"]
    },
    "Payslip": {
      "title": "Payslip",
      "description": "Monthly payroll disbursement document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeCode": { "type": "string" },
        "employeeName": { "type": "string" },
        "payrollMonth": { "type": "string" },
        "basicSalary": { "type": "number" },
        "grossEarnings": { "type": "number" },
        "netSalary": { "type": "number" }
      },
      "required": ["id", "employeeId", "payrollMonth"]
    },
    "CompanyBranding": {
      "title": "CompanyBranding",
      "description": "Company white-label branding, logo, and system settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "primaryColor": { "type": "string" },
        "isDemoModeEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "Organizational project entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "Assigned task with deadline, check-in timer, submission, and review thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "assignedToEmployeeId": { "type": "string" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" }
      },
      "required": ["id", "title", "assignedToEmployeeId", "status"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "Targeted portal notifications for task updates, reviews, and surveys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "targetEmployeeId": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message"]
    },
    "DailyWorkLog": {
      "title": "DailyWorkLog",
      "description": "Employee daily work log entry for office, remote, or field work",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "workMode": { "type": "string" },
        "title": { "type": "string" },
        "durationMinutes": { "type": "number" }
      },
      "required": ["id", "employeeId", "date", "title"]
    },
    "FeedbackSurvey": {
      "title": "FeedbackSurvey",
      "description": "Scheduled monthly, semi-annual, annual, or custom employee satisfaction survey",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "cycleType": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "cycleType"]
    },
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "Employee survey submission with structured ratings and comments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "surveyId": { "type": "string" },
        "employeeId": { "type": "string" },
        "overallScore": { "type": "number" }
      },
      "required": ["id", "surveyId", "employeeId"]
    },
    "AnonymousFeedback": {
      "title": "AnonymousFeedback",
      "description": "Zero-PII anonymous employee feedback submission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "category", "subject", "message"]
    },
    "TeamMemberRating": {
      "title": "TeamMemberRating",
      "description": "Monthly structured performance points awarded by managers to team members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "ratedByEmployeeId": { "type": "string" },
        "month": { "type": "string" },
        "totalPoints": { "type": "number" }
      },
      "required": ["id", "employeeId", "ratedByEmployeeId", "month"]
    },
    "ManagerRating": {
      "title": "ManagerRating",
      "description": "Monthly evaluation of a direct reporting line manager submitted by their team members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "managerId": { "type": "string" },
        "ratedByEmployeeId": { "type": "string" },
        "month": { "type": "string" },
        "totalScore": { "type": "number" }
      },
      "required": ["id", "managerId", "ratedByEmployeeId", "month"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "All organization employees and staff records"
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Regional and head office branch locations"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Organizational department structures"
    },
    "/designations/{designationId}": {
      "schema": "Designation",
      "description": "Job designations and titles"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Daily biometric attendance logs"
    },
    "/leaves/{leaveId}": {
      "schema": "LeaveApplication",
      "description": "Employee leave applications"
    },
    "/payroll/{payrollId}": {
      "schema": "Payslip",
      "description": "Monthly salary slips and records"
    },
    "/settings/{settingId}": {
      "schema": "CompanyBranding",
      "description": "Organization branding and configuration"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Organizational projects"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Assigned team tasks and review workflows"
    },
    "/notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "Targeted user portal notifications"
    },
    "/work_logs/{logId}": {
      "schema": "DailyWorkLog",
      "description": "Employee daily work logs"
    },
    "/feedback_surveys/{surveyId}": {
      "schema": "FeedbackSurvey",
      "description": "Periodic employee surveys"
    },
    "/survey_responses/{responseId}": {
      "schema": "SurveyResponse",
      "description": "Employee survey responses"
    },
    "/anonymous_feedback/{feedbackId}": {
      "schema": "AnonymousFeedback",
      "description": "Zero-PII anonymous feedback box submissions"
    },
    "/performance_points/{ratingId}": {
      "schema": "TeamMemberRating",
      "description": "Monthly manager-awarded team performance points"
    },
    "/manager_ratings/{ratingId}": {
      "schema": "ManagerRating",
      "description": "Monthly employee-submitted ratings for their direct reporting line manager"
    }
  }
}
